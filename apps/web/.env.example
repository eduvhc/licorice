# Keys only — never real values. Copy to .env and fill it in for local dev;
# for the Coolify deployment these go in the UI (see DEPLOY.md).
# The schema that validates them at boot is apps/web/lib/env.ts.

# Required.
BETTER_AUTH_SECRET=        # openssl rand -hex 32
BETTER_AUTH_URL=           # the origin the browser uses, e.g. http://192.168.50.211:3000
DATABASE_URL=              # /app/data/better-auth.db  (Better Auth's own schema)
APP_DATABASE_URL=          # /app/data/app.db          (the app's Kysely migrations)

# Optional — each has a default or disables its feature when unset.
EMAIL_FROM=
LOG_LEVEL=                 # fatal|error|warn|info|debug|trace
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Social login — each provider turns itself on once its pair is set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
