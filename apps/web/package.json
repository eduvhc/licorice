    "eslint-config-prettier": "^10.1.8",
    "kysely-ctl": "^0.21.0",
    "pino-pretty": "^13.1.3",
    "react-email": "^6.9.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
