    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.5",
    "lucide-react": "^1.32.0",
    "next": "16.2.6",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
